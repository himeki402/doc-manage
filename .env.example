# Docker Compose - local development
# Copy this file to .env and replace placeholder values before starting.

# Host ports (the services communicate internally using the service names).
WEB_PORT=3000
API_PORT=8080
OCR_PORT=8000
POSTGRES_HOST_PORT=5432

# PostgreSQL (inside the Docker network)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=docmanage
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=docmanage

# API
PORT=8080
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRATION_TIME=3600
PDF_EXTRACT_SERVICE_URL=http://ocr:8000/extract-text

# Browser-visible URLs. These intentionally use localhost, not Docker service names.
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_OCR_API_URL=http://localhost:8000
NEXT_PUBLIC_SUMMARY_API_URL=

# External services. Set real credentials only in .env or in the deployment secret store.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_BUCKET_NAME=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ENCRYPTION_KEY=

